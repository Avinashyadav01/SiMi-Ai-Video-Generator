GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
# Choose gemini, ollama (local), or auto (try local Ollama, then Gemini).
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:4b
OLLAMA_TIMEOUT=240
TTS_VOICE=en-IN-NeerjaNeural
TTS_RATE=+0%
TTS_VOLUME=+0%
# For production, set APP_ENV=production, APP_ORIGIN to the exact public HTTPS origin,
# and COOKIE_SECURE=true. Production startup rejects missing or insecure origin config.
APP_ENV=development
APP_ORIGIN=
COOKIE_SECURE=false
# Generate a fresh token-encryption key with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
OAUTH_ENCRYPTION_KEY=
# Publishing stays off unless you explicitly enable it after provider review.
PUBLISHING_ENABLED=false
PREPUBLISH_LEAD_MINUTES=30
AUTO_PUBLISH_LATE_GRACE_MINUTES=60
# Required for short-lived, signed HTTPS media URLs used by Instagram's API.
MEDIA_SIGNING_KEY=
PUBLIC_BASE_URL=
# Google Cloud OAuth web client (YouTube Data API v3 must be enabled).
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/api/oauth/youtube/callback
# Meta developer app; add these exact callback URLs to Valid OAuth Redirect URIs.
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=
META_INSTAGRAM_REDIRECT_URI=http://localhost:8000/api/oauth/instagram/callback
META_FACEBOOK_REDIRECT_URI=http://localhost:8000/api/oauth/facebook/callback
# ASSETS_DIR=data/assets
# OUTPUT_DIR=output
# DATABASE_PATH=data/database/jobs.sqlite3
